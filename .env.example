# =============================================================================
# AI Resume Screening & Candidate Ranking System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME="AI Resume Screening System"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///./resume_screening.db
# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_screening_db

# --- JWT Authentication ---
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Default Admin Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@resumescreening.ai

# --- File Upload ---
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx
UPLOAD_DIR=uploads
BACKEND_UPLOAD_DIR=backend/uploads

# --- AI / ML ---
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
MODEL_CACHE_DIR=.cache/models
EMBEDDING_BATCH_SIZE=32

# --- Scoring Weights (must sum to 100) ---
WEIGHT_SKILL_MATCH=40
WEIGHT_EXPERIENCE=20
WEIGHT_EDUCATION=15
WEIGHT_PROJECTS=15
WEIGHT_CERTIFICATIONS=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=backend/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Reports ---
REPORTS_DIR=reports
